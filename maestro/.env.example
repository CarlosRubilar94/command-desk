# Maestro — example environment (Phase 1 / MVP, read-only)
# Copy the relevant lines into <HERMES_HOME>/.env (Windows: %LOCALAPPDATA%\hermes\.env).
# NEVER commit real secrets. Bitwarden is the source of truth; inject at runtime.

# ---- Hostinger "empresa" mailbox (IMAP, read-only) -------------------------
# Hostinger-vs-Titan flag: "hostinger" -> imap.hostinger.com, "titan" -> imap.titan.email
MAESTRO_HOSTINGER_EMPRESA_PROVIDER=hostinger
MAESTRO_HOSTINGER_EMPRESA_USER=contato@suaempresa.com
MAESTRO_HOSTINGER_EMPRESA_APP_PASSWORD=__app_password_da_caixa__
# Optional overrides (defaults shown):
# MAESTRO_HOSTINGER_EMPRESA_HOST=imap.hostinger.com
# MAESTRO_HOSTINGER_EMPRESA_PORT=993
# MAESTRO_HOSTINGER_EMPRESA_SSL=true
# MAESTRO_HOSTINGER_EMPRESA_MAILBOX=INBOX
# MAESTRO_HOSTINGER_EMPRESA_LABEL=hostinger_empresa

# ---- Gmail pessoal (via Hermes MCP user-google-tools, OAuth — no key here) --
MAESTRO_GMAIL_PESSOAL_ENABLED=false
# MAESTRO_GMAIL_MCP_SERVER=user-google-tools
# MAESTRO_GMAIL_QUERY=is:unread newer_than:1d
# MAESTRO_GMAIL_PESSOAL_LABEL=gmail_pessoal

# ---- Triage model (Gemini Flash) — key usually already in .env --------------
# GEMINI_API_KEY=...        (or GOOGLE_API_KEY=...)
# MAESTRO_TRIAGE_MODEL=gemini-2.5-flash
# MAESTRO_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Reasoning (Claude Code CLI, headless subprocess, Pro/OAuth — NO key) ---
# MAESTRO_REASONING_ENABLED=true
# MAESTRO_CLAUDE_BIN=claude
# MAESTRO_CLAUDE_ARGS=-p
# MAESTRO_CLAUDE_TIMEOUT=120

# ---- WhatsApp self-chat delivery (existing Hermes Baileys bridge) -----------
# Your OWN number (self-chat). Falls back to WHATSAPP_HOME_CHANNEL if unset.
MAESTRO_WHATSAPP_TARGET=55XXXXXXXXXXX
# MAESTRO_WHATSAPP_BRIDGE_PORT=3000   (falls back to WHATSAPP_BRIDGE_PORT)

# ---- Digest window / schedule / token economy -------------------------------
# MAESTRO_WINDOW_HOURS=24
# MAESTRO_MAX_EMAILS=40
# MAESTRO_BODY_MAX_CHARS=1200
# MAESTRO_CACHE_TTL_DAYS=14
# MAESTRO_TIMEZONE=America/Sao_Paulo
# MAESTRO_DIGEST_HOUR=7

# ---- Safety / runtime -------------------------------------------------------
# MAESTRO_DRY_RUN=false                 # force preview-only (never send) globally
# MAESTRO_PREVIEW_DIR=                  # default: <HERMES_HOME>/maestro/preview
# MAESTRO_PHASE2_ACTIONS_ENABLED=false  # Phase 2 (trash/etc) — keep DISABLED in Phase 1
# MAESTRO_HERMES_ROOT=                  # repo root for the cron launcher (portability)
